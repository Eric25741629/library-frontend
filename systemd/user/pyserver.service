# User systemd unit for the Flask server.
# Paths are rendered at install time so the service can be moved across machines/users.

[Unit]

Description=Python Server (Flask) - autostart

After=network-online.target

Wants=network-online.target



[Service]

Type=simple

Environment=DISPLAY=:0

WorkingDirectory=__PROJECT_DIR__

ExecStartPre=/bin/bash __HOME__/bin/wait_gui_ready.sh 180

ExecStart=/usr/bin/python3 __PROJECT_DIR__/app.py

Restart=on-failure

RestartSec=2



[Install]

WantedBy=default.target
